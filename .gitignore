# Virtualenvs. venv/ also self-ignores (Python 3.11+ writes venv/.gitignore),
# but name it here so a differently-created env is covered too.
venv/
.venv/
env/

# Model caches — sentence-transformers / HuggingFace / spaCy pull these at
# runtime; they are large and reproducible from requirements.txt.
.cache/
models/

# Local SQLite databases. Production is Postgres (doc 15 §4); a .db file in the
# tree is somebody's scratch data and must never be committed.
*.db
*.sqlite
*.sqlite3
